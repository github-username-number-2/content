            if self._curitm is not None:
                self._parent.reject_session(self._curitm["idSession"])
                self._skip_ids.append(self._curitm["idSession"])
                self._curitm=None
            self._dlg.hide()
        
    def update(self, ar):
        itm=None
        for i in ar:
